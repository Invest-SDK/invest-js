{
  "name": "engine-node",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/engine-node/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/engine-node",
        "tsConfig": "libs/engine-node/tsconfig.lib.json",
        "packageJson": "libs/engine-node/package.json",
        "main": "libs/engine-node/src/index.ts",
        "assets": ["libs/engine-node/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      }
    }
  }
