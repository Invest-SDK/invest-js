{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "lint": {
      "options": {
        "max-warnings": 0,
        "fix": true
      }
    },
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/libs/{projectName}"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": ["examples/nest-sdk-e2e/**/*"]
    }
  ],
  "release": {
    "groups": {
      "contract": {
        "projects": ["libs/grpc", "libs/grpc-node-client", "libs/grpc-web-client"],
        "projectsRelationship": "fixed",
        "releaseTagPattern": "v{version}/contract"
      }
    },
    "changelog": {
      "projectChangelogs": false,
      "workspaceChangelog": false
    },
    "git": {
      "commitArgs": ["--no-verify"]
    }
  }
}
