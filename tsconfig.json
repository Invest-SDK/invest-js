{
  "compilerOptions": {
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "paths": {
      "@t-tech/engine-node": ["libs/engine-node/src/index.ts"],
      "@t-tech/invest-rest-client": ["libs/rest-client/src/index.ts"],
      "@t-tech/invest-sdk-node": ["libs/sdk-node/src/index.ts"],
      "@t-tech/invest-shared": ["libs/shared/src/index.ts"],
      "@t-tech/sdk-web": ["libs/sdk-web/src/index.ts"],
      "@ttech-pub/grpc": ["libs/grpc/src/index.ts"],
      "@ttech-pub/grpc-node-client": ["libs/grpc-node-client/src/index.ts"],
      "@ttech-pub/grpc-web-client": ["libs/grpc-web-client/src/index.ts"]
    }
  },
  "exclude": ["examples/grpc-web-example", "build", "grpc", "grpc-web"]
}
